# =============================================================================
# Medusa Next.js Storefront — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values:
#   cp .env.local.example .env.local
# =============================================================================

# ── Medusa Backend ──────────────────────────────────────────────────────────
# Local development (Codespaces or local machine)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Publishable API key from Medusa admin dashboard
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key_here

# ── Storefront Base URL ─────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# ── Stripe Payment ──────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_stripe_publishable_key_here

# ── Algolia Search (optional) ───────────────────────────────────────────────
# Get credentials from https://www.algolia.com/
NEXT_PUBLIC_SEARCH_APP_ID=your_algolia_app_id
NEXT_PUBLIC_SEARCH_API_KEY=your_algolia_search_api_key
NEXT_PUBLIC_SEARCH_INDEX_NAME=products

# ── Vercel Deploy (set in Vercel dashboard, not here) ───────────────────────
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://your-medusa-backend.azurecontainerapps.io
# NEXT_PUBLIC_STRIPE_KEY=pk_live_...
# REVALIDATE_SECRET=your_revalidation_secret
